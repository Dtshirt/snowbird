# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=snowbird

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Email addresses
MAIL_FROM=Snowbird Car Shipping <quotes@snowbird.carshippinghub.com>
SALES_EMAIL=sales@snowbird.carshippinghub.com

# Google Maps Places API (for pickup/delivery address autocomplete on the quote form)
# Enable the Places API for the key in Google Cloud Console and restrict it to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=MAP_KEY

# Site
SITE_URL=https://snowbird.carshippinghub.com
NEXT_PUBLIC_SITE_URL=https://snowbird.carshippinghub.com

# Optional: rate limiting window (seconds) and max per IP
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=8
